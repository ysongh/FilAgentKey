# Copy to .env (gitignored) and fill in. Both scripts auto-load .env if present.
# NEVER commit a real key. Calibration testnet keys only.

# --- pnpm owner:create (spike only — the dashboard will use the browser wallet) ---
ROOT_PRIVATE_KEY=0xYOUR_FUNDED_CALIBRATION_WALLET_PRIVATE_KEY
# Session key lifetime in minutes (optional, default 60)
# SESSION_TTL_MINUTES=60

# --- pnpm agent (the ONLY two variables the agent gets; printed by owner:create) ---
SESSION_PRIVATE_KEY=0xPRINTED_ONCE_BY_OWNER_CREATE
ROOT_ADDRESS=0xYOUR_WALLET_PUBLIC_ADDRESS